# Copy this file to .env (git ignores it) and fill in the key.
# A variable already set in your shell takes precedence over this file.
GEMINI_API_KEY=

# Optional settings, shown with their defaults:
# DOC2DATA_GEMINI_MODEL=gemini-3.5-flash-lite
# DOC2DATA_DATABASE_URL=sqlite:///doc2data.db
#
# The extractor is chosen on the command line: make demo EXTRACTOR=gemini,
# or --extractor gemini. Outside make, DOC2DATA_EXTRACTOR=gemini also works.
